---
import { withBase } from "../utils/paths";

interface Props {
  tone?: "dark" | "light";
}

const { tone = "dark" } = Astro.props;
---

<header class:list={["site-nav", tone === "light" && "site-nav--light"]}>
  <a class="site-nav__brand" href={withBase("/")}>Екатерина Хохлова</a>
  <nav class="site-nav__links" aria-label="Основная навигация">
    <a href={withBase("/#work")}>Работы</a>
    <a class="site-nav__method-link" href={withBase("/#method")}>Подход</a>
    <a href={withBase("/#contact")}>Контакт</a>
  </nav>
</header>
